eated":"2026-07-08T13:10:35.901+0200","items":[{"field":"Acceptance Criteria","fieldtype":"custom","fieldId":"customfield_10082","from":null,"fromString":null,"to":"","toString":"* [ ] is_valid column exists on calculated_rates table after migration                                                                                         \n* [ ] Newly ingested rates with commission = 0 or order_value = 0 are stored with is_valid = false                                                             \n* [ ] Reification endpoint does not include invalid rates in the indexed document                                                                              \n* [ ] Existing invalid rates backfilled correctly"}]},{"id":"978007","author":{"self":"https://mrge.atlassian.net/rest/api/3/user?accountId=712020%3A5f6594bb-5ebe-4826-ab31-adfa524c3f7d","accountId":"712020:5f6594bb-5ebe-4826-ab31-adfa524c3f7d","emailAddress":"randy.bartumeu@mrge.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/0860112590922a23f80b9d53e0b9600e?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FRH-4.png","24x24":"https://secure.gravatar.com/avatar/0860112590922a23f80b9d53e0b9600e?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FRH-4.png","16x16":"https://secure.gravatar.com/avatar/0860112590922a23f80b9d53e0b9600e?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FRH-4.png","32x32":"https://secure.gravatar.com/avatar/0860112590922a23f80b9d53e0b9600e?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FRH-4.png"},"displayName":"Randy Héctor Bartumeu Huergo","active":true,"timeZone":"Europe/Berlin","accountType":"atlassian"},"created":"2026-07-08T13:10:53.951+0200","items":[{"field":"description","fieldtype":"jira","fieldId":"description","from":null,"fromString":null,"to":null,"toString":"Calculated rates where initial_commission_eur = 0 or initial_order_value_eur = 0 were being filtered in the wrong layer (Kotlin model). This moves the validity\n  check to the database so invalid data is preserved for metrics/reporting while the reification pipeline only processes valid rates.                            \n\n  Changes:                                                                                                                                                       \n\n* Flyway migration V00070: adds is_valid boolean NOT NULL to pub_intelligence_hub.calculated_rates, backfills from existing data                               \n* JPA entity: exposes is_valid field                                                                                                                           \n* Write path (CalculatedRateService): computes and persists is_valid = commission > 0 AND order_value > 0 on every upsert                                      \n* Reification CTE: filters WHERE is_valid = true so invalid rates never reach the index                                                                        \n\n  Why: Invalid rates (zero commission or zero order value) caused division-by-zero issues downstream. Storing them with a validity flag lets us keep the raw data\n  for future reporting while preventing bad data from reaching the OpenSearch index.  "}]},{"id":"978008","author":{"self":"https://mrge.atlassian.net/rest/api/3/user?accountId=712020%3A5f6594bb-5ebe-4826-ab31-adfa524c3f7d","accountId":"712020:5f6594bb-5ebe-4826-ab31-adfa524c3f7d","emailAddress":"randy.bartumeu@mrge.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/0860112590922a23f80b9d53e0b9600e?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FRH-4.png","24x24":"https://secure.gravatar.com/avatar/0860112590922a23f80b9d53e0b9600e?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FRH-4.png","16x16":"https://secure.gravatar.com/avatar/0860112590922a23f80b9d53e0b9600e?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FRH-4.png","32x32":"https://secure.gravatar.com/avatar/0860112590922a23f80b9d53e0b9600e?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FRH-4.png"},"displayName":"Randy Héctor Bartumeu Huergo","active":true,"timeZone":"Europe/Berlin","accountType":"atlassian"},"created":"2026-07-08T13:11:04.289+0200","items":[{"field":"status","fieldtype":"jira","fieldId":"status","from":"1","fromString":"Open","to":"3","toString":"In Progress"}]}]}